# Normalize to LF in the repo, check out native on Windows.
* text=auto

# Any decompiled source that does get committed stays byte-exact.
*.cs  text eol=lf
*.il  -text diff
*.h   text eol=lf

# Treat known binary blobs as binary even if one slips past .gitignore.
*.dll     binary
*.exe     binary
*.so      binary
*.assets  binary
*.bundle  binary
*.dat     binary
