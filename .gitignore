# ---------------------------------------------------------------------------
# Game files and decompiler output.
#
# Everything the game ships and everything derived from it is the publisher's
# copyrighted material. Keep it on disk, keep it out of the repo.
# ---------------------------------------------------------------------------

# The game itself. One dedicated folder; nothing inside it is ever
# committed. Only the folder's own README is tracked, so a fresh clone
# still shows you where the game is meant to go.
game/*
!game/README.md

# Decompiler / extractor output
decompiled/
extracted/
dumped/
exported/
out/
output/
dump.cs
dump.cs.*
dump.h
dump.json
script.json
il2cpp.h
stringliteral.json

# Safety net for game artifacts wherever they turn up outside game/.
# Deliberately narrow: broad globs like *.png or level* would also
# swallow diagrams and notes you do want tracked.
*_Data/
GameAssembly.*
global-metadata.dat
Assembly-CSharp*.dll
*.assets
*.assets.resS
*.sharedAssets
*.resource
*.bundle
*.unity3d
globalgamemanagers*
*.exe
*.dll
*.so
*.dylib
*.pdb
*.il
*.bnk

# ---------------------------------------------------------------------------
# Tooling (download it, don't vendor it)
# ---------------------------------------------------------------------------
tools/*
!tools/README.md
*.zip
*.7z
*.rar
*.tar
*.tar.gz

# ---------------------------------------------------------------------------
# Scratch
# ---------------------------------------------------------------------------
scratch/
tmp/
temp/
*.log
*.tmp
*.bak

# ---------------------------------------------------------------------------
# Python (analysis scripts)
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
env/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.ipynb_checkpoints/

# ---------------------------------------------------------------------------
# .NET (if you build analysis tooling or reimplementations)
# ---------------------------------------------------------------------------
bin/
obj/
.vs/
*.user
*.suo

# ---------------------------------------------------------------------------
# Node (if any tooling needs it)
# ---------------------------------------------------------------------------
node_modules/
npm-debug.log*

# ---------------------------------------------------------------------------
# Editors / OS
# ---------------------------------------------------------------------------
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
Thumbs.db
desktop.ini
$RECYCLE.BIN/
.DS_Store
