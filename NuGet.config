<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- BepInEx does not publish to nuget.org; BepInEx.Core and HarmonyX come
         from the project's own feed. Krafs.Publicizer is on nuget.org. -->
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="bepinex" value="https://nuget.bepinex.dev/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
